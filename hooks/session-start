#!/usr/bin/env bash
# Master-skill session-start hook — injects the available-masters list into
# the conversation context. Compatible with Claude Code, Cursor, Copilot CLI.
#
# The work is in session_start.py. This was a bash loop that started python3
# once per master to sanitize a single `lineage:` value, plus once more to
# encode JSON: 17 interpreter starts, 0.37s measured, on a hook the harness
# runs with "async": false at every startup / clear / compact.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PLUGIN_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Fail closed. The previous fallback was `|| echo "\"$CONTEXT\""`, which on a
# machine without python3 emitted an unescaped multi-line string where JSON
# was expected. An empty object is the only safe thing to hand something that
# splices its input into a system prompt.
if ! command -v python3 >/dev/null 2>&1; then
    echo '{}'
    exit 0
fi

# A failure here must stay visible. `|| echo '{}'` alone once hid a
# UnicodeEncodeError behind a well-formed empty payload — the harness saw
# valid JSON, exit 0, and no masters. stderr is not part of the hook protocol,
# so writing there degrades safely while leaving a trace.
if ! python3 "$SCRIPT_DIR/session_start.py" "$PLUGIN_ROOT"; then
    echo "master-skill session-start hook failed; injecting no masters" >&2
    echo '{}'
fi
